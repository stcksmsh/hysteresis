{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["audioworklet", "vite/client"]
  },
  "include": [
    "src/audio/worklet/**/*.ts",
    "src/render/worker/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
