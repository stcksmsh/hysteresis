{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // DOM only for ambient types (OffscreenCanvas etc. appear in shared/types.ts,
    // now transitively imported for StructuralEvent/BandEnergies) — nothing under
    // tools/ actually runs in a browser or touches these APIs at runtime.
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "tools/**/*.ts",
    "src/shared/constants.ts",
    "src/shared/timeline.ts",
    "src/audio/worklet/fft.ts",
    "src/audio/worklet/spectral.ts",
    "src/audio/worklet/onset.ts",
    "src/audio/worklet/envelope.ts"
  ]
}
