}*/

#ifdef GL_ES
precision highp float;
#endif

// refOrbit/beamTex (scriptTexture / lineTrace pass outputs — see PASSES above) are auto-declared
// by the runtime, not here (translate-isf-glsl.ts emits `uniform sampler2D <target>;` for every
// non-'' pass TARGET automatically — declaring them again here would be a GLSL redeclaration
// error). refOrbit holds the perturbation reference orbit HYSTERESIS_SCRIPT computes every frame
// (Z_i in texel i, RG32F) — same exact technique as the real built-in scene's uRefOrbit
// (JuliaScene.ts's updateReferenceOrbit / julia.frag.glsl's iteratePerturbed).

const int MAX_ITER = 192;

vec2 cMul(vec2 a, vec2 b) {
	return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

int iterateDirect(vec2 z0, out vec2 finalZ) {
	vec2 z = z0;
	int iter = 0;
	for (int i = 0; i < MAX_ITER; i++) {
		if (dot(z, z) > 4.0) {
			finalZ = z;
			return iter;
		}
		z = cMul(z, z) + c;
		iter++;
	}
	finalZ = z;
	return iter;
}

// Perturbation: iterates only delta, the tiny offset from the reference orbit, via
// delta_{n+1} = 2*Z_n*delta_n + delta_n^2 (the c terms cancel) — delta stays small and
// well-conditioned in float32 regardless of zoom depth. Exact port of
// julia.frag.glsl's iteratePerturbed, reading refOrbit (this file's scriptTexture pass)
// instead of uRefOrbit.
int iteratePerturbed(vec2 delta0, out vec2 finalZ) {
	vec2 delta = delta0;
	int iter = 0;
	finalZ = pan + delta;
	for (int i = 0; i < MAX_ITER; i++) {
		vec2 Zi = texelFetch(refOrbit, ivec2(i, 0), 0).xy;
		vec2 full = Zi + delta;
		if (dot(full, full) > 4.0) {
			finalZ = full;
			return iter;
		}
		delta = 2.0 * cMul(Zi, delta) + cMul(delta, delta);
		iter++;
	}
	return iter;
}

// Real escape-time banding (same fix as julia.hyst v1's own palette — see that file's header
// comment for why the original single-fade version hid the fractal's fine structure).
const float BANDS = 5.0;
vec3 palette(float t, float hueShift, float paletteMix, vec3 accent, bool interior) {
	vec3 base = vec3(0.04, 0.035, 0.07);
	vec3 violet = vec3(0.29, 0.18, 0.55);
	if (interior) return base;
	float h = hueShift + paletteFlip * 0.5;
	float bands = t * BANDS;
	vec3 hueRot = vec3(
		0.5 + 0.5 * cos(6.28318 * (bands + h)),
		0.5 + 0.5 * cos(6.28318 * (bands + h + 0.33)),
		0.5 + 0.5 * cos(6.28318 * (bands + h + 0.67))
	);
	vec3 mood = mix(base, violet * hueRot, smoothstep(0.0, 0.35, t));
	return mix(mood, accent * hueRot, paletteMix * 0.6);
}

void main() {
	vec2 uv = (gl_FragCoord.xy - 0.5 * RENDERSIZE.xy) / RENDERSIZE.y;

	vec2 z;
	int iter;
	// Uniform-only branch — every fragment in the draw call takes the same side, same as the
	// real built-in scene's uZoom > uPerturbThreshold branch.
	if (zoom > perturbThreshold) {
		iter = iterateDirect(pan + uv * zoom, z);
	} else {
		iter = iteratePerturbed(uv * zoom, z);
	}

	float smoothIter = float(iter);
	if (iter < MAX_ITER) {
		float logZn = log(dot(z, z)) * 0.5;
		float nu = log(logZn / log(2.0)) / log(2.0);
		smoothIter = float(iter) + 1.0 - nu;
	}
	float t = smoothIter / float(MAX_ITER);
	bool interior = (iter >= MAX_ITER);

	// hueShift/paletteMix stay ordinary closed-form GLSL fed by live signals — no reason to move
	// logic into the script that GLSL already expresses fine (same posture julia.hyst v1 takes).
	float hueShift = fract(TIME * 0.05 + centroidIn * 0.1);
	float paletteMix = windup;
	vec3 accent = accentColor.rgb;
	vec3 color = palette(t, hueShift, paletteMix, accent, interior);
	color = mix(color, vec3(0.0), flash);

	// beatIn: a light on-beat twinkle, same as julia.hyst v1.
	color += beatIn * 0.12 * accent;

	// The oscilloscope beam (real waveform when playing, the built-in idle Lissajous otherwise)
	// — additively blended, tinted with the same accent color the substrate's palette uses.
	vec4 beam = texture2D(beamTex, isf_FragNormCoord);
	color += beam.rgb * accent * beamGain;

	gl_FragColor = vec4(color, 1.0);
}
