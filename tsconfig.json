{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "w3c-web-serial"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/audio/worklet/**",
    "src/render/worker/**"
  ]
}
