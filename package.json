{
  "name": "sinteza-viz",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/render-worker.js": "./dist/render-worker.js",
    "./dist/worklets/feature-worklet.js": "./dist/worklets/feature-worklet.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "npm run build:worklet && npm run build:render-worker && concurrently -k -n worklet,render-worker,vite \"vite build --config vite.worklet.config.ts --watch\" \"vite build --config vite.render-worker.config.ts --watch\" \"vite\"",
    "build:worklet": "vite build --config vite.worklet.config.ts",
    "build:render-worker": "vite build --config vite.render-worker.config.ts",
    "build": "npm run build:worklet && npm run build:render-worker && vite build",
    "build:lib": "npm run build:worklet && npm run build:render-worker && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "patchbay": "npm run build:worklet && npm run build:render-worker && vite --config vite.patchbay-editor.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p tsconfig.patchbay-editor.json",
    "test": "vitest run",
    "analyze": "tsx scripts/analyze.ts",
    "render-video": "tsx scripts/render-video.ts",
    "udp-relay": "tsx scripts/udp-relay.ts",
    "tcp-relay": "tsx scripts/tcp-relay.ts",
    "prepare": "npm run build:lib"
  },
  "dependencies": {
    "fft.js": "^4.0.4"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@types/audioworklet": "^0.0.100",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.4",
    "puppeteer-core": "^25.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  }
}
